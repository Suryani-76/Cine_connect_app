{
  "name": "cineconnect",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:clean": "(lsof -ti:3000,5173,4173 | xargs kill 2>/dev/null || true) && npm run dev",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build": "npm run build:server && npm run build:client",
    "preview": "npm run preview --workspace=client",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "test": "npm run test:server && npm run test:client",
    "typecheck:server": "cd server && npx tsc --noEmit",
    "typecheck:client": "cd client && npx tsc --noEmit",
    "typecheck": "npm run typecheck:server && npm run typecheck:client",
    "check:tables": "npx tsx scripts/check-table-refs.ts",
    "rotate:invite-codes": "npx tsx scripts/rotate-invite-codes.ts",
    "admin:add": "npx tsx scripts/add-admin.ts",
    "validate-env": "npx tsx scripts/validate-env.ts",
    "health-check": "npx tsx scripts/health-check.ts",
    "build-check": "bash scripts/build-check.sh",
    "docker:build": "docker build -t cineconnect-server ./server",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "playwright": "^1.63.0"
  }
}
